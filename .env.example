# Path to the private brain vault (never commit real values)
JAVIS_BRAIN_DIR=

# Telegram bot settings (required for javis serve)
JAVIS_TELEGRAM_TOKEN=
JAVIS_TELEGRAM_CHAT_ID=

# Optional, only for ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional shell environment variable (default: ~/.javis, outside the repo)
# JAVIS_DATA_DIR=
